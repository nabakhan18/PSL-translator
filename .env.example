PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
DATABASE_PATH=./data/psl_translator.db
NODE_ENV=development

# Optional: only needed if you plug in a real LLM for meaning extraction
# (see src/services/meaningExtraction.js). Leave blank to use the built-in
# rule-based extractor, which needs no external API key.
LLM_API_KEY=
LLM_API_URL=
